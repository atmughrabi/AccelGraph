#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(cd "$script_dir/.." && pwd -P)
capi_root="$repo_root/01_capi_precis"
harness="$capi_root/tools/capi-env"

if [[ ! -x "$harness" ]]; then
    echo "CAPI-Precis environment harness is unavailable: $harness" >&2
    echo "Run: git submodule update --init --recursive" >&2
    exit 2
fi

arguments=("$@")
index=0
while ((index < ${#arguments[@]})); do
    argument=${arguments[$index]}
    case "$argument" in
        check|print|shell|run|--)
            break
            ;;
        --project-root|--capi-root|--sim-root)
            echo "$argument is fixed by the AccelGraph wrapper" >&2
            echo "Invoke $harness directly for an unpinned layout." >&2
            exit 2
            ;;
        --mode|--intel-fpga|--pslver|--bit32)
            index=$((index + 2))
            continue
            ;;
    esac
    index=$((index + 1))
done

exec "$harness" \
    --project-root "$repo_root" \
    --capi-root "$capi_root" \
    --sim-root "$repo_root/03_capi_integration/accelerator_sim" \
    "$@"
