      "root_cause_file": "01_capi_precis/01_capi_integration/accelerator_rtl/afu_control/round_robin_priority_arbiter.sv",
      "root_cause_module": "round_robin_priority_arbiter_N_input_1_ouput",
      "families": [
        "cluster-scheduler",
        "graph-algorithm-scheduler",
        "algorithm-arbiters"
      ],
      "modules": [
        "cu_vertex_cluster_arbiter_control",
        "cu_graph_algorithm_arbiter_control",
        "*_arbiter_control"
      ],
      "reason": "round_robin_priority_arbiter_N_input_1_ouput assigns arbiter_out for every asserted submit bit instead of the granted bit. With held/all requests, ready identifies one owner while the payload comes from the highest loop index.",
      "recommended_patch": "In the registered arbitration loop, change `if (submit[i]) arbiter_out <= buffer_in[i];` to `if (submit[i] && grant[i]) arbiter_out <= buffer_in[i];`. Keep ready[i] driven by grant[i] and retain the existing no-submit clear."
    }
