        {"id": "route-qualifier-forced", "pattern": "data_out_valid_internal\\[i\\] <= data_in_valid_internal;", "replacement": "data_out_valid_internal[i] <= 1'b1;", "diagnostic": "route qualifier mismatch"}
      ],
      "array_struct_type_demux_bus": [
        {"id": "struct-destination-0-dropped", "pattern": "data_out_valid_internal\\[0\\] <= data_in_valid_internal;", "replacement": "data_out_valid_internal[0] <= 1'b0;", "diagnostic": "route qualifier mismatch"},
        {"id": "struct-payload-inverted", "pattern": "data_out_internal\\[0\\] <= data_in_internal;", "replacement": "data_out_internal[0] <= ~data_in_internal;", "diagnostic": "route payload mismatch"},
        {"id": "struct-unassigned-selector-routed", "pattern": "default : begin\\s*\\n\\s*data_out_valid_internal\\[0\\] <= 0;", "replacement": "default : begin\n\t\t\t\t\tdata_out_valid_internal[0] <= data_in_valid_internal;", "diagnostic": "route qualifier mismatch"}
      ],
      "sum_reduce": [
        {"id": "reduction-term-dropped", "pattern": "total_sum_out_latched = total_sum_out_latched \\+ partial_sums_in_latched\\[j\\];", "replacement": "total_sum_out_latched = total_sum_out_latched;", "diagnostic": "reduction mismatch"},
        {"id": "reduction-enable-ignored", "pattern": "if\\(enabled\\[i\\]\\) begin", "replacement": "if(1'b1) begin", "diagnostic": "reduction mismatch"},
        {"id": "reduction-reset-value", "pattern": "total_sum_out <= 0;", "replacement": "total_sum_out <= 1;", "diagnostic": "reduction mismatch"}
      ],
      "WED_PKG": [
        {"id": "descriptor-field-offset-shifted", "pattern": "swap_endianness_word\\(in\\[0:31\\]\\)", "replacement": "swap_endianness_word(in[32:63])", "diagnostic": "map.num_edges"},
        {"id": "descriptor-cabt-decode-swapped", "pattern": "cabt = PAGE;", "replacement": "cabt = ABORT;", "diagnostic": "map_CABT"}
      ],
      "CU_PKG": [
        {"id": "endianness-swap-disabled", "pattern": "out\\[i\\*8 \\+: 8\\] = in\\[\\(\\(VERTEX_SIZE_BITS-1\\)-\\(i\\*8\\)\\) -:8\\];", "replacement": "out[i*8 +: 8] = in[(i*8) +: 8];", "diagnostic": "swap_endianness_vertex_read"},
        {"id": "request-size-threshold-shifted", "pattern": "if \\(vertex_num_size > 64\\)", "replacement": "if (vertex_num_size > 63)", "diagnostic": "cmd_size_calculate"}
      ],
      "GLOBALS_CU_PKG": [
        {"id": "layout-graph-cu-count", "pattern": "parameter NUM_GRAPH_CU_GLOBAL(\\s+)= (\\d+);", "replacement": "parameter NUM_GRAPH_CU_GLOBAL\\1= 7;", "diagnostic": "NUM_GRAPH_CU_GLOBAL"},
        {"id": "vertex-width-derivation", "pattern": "parameter VERTEX_SIZE_BITS(\\s+)= VERTEX_SIZE \\* 8", "replacement": "parameter VERTEX_SIZE_BITS\\1= VERTEX_SIZE * 4", "diagnostic": "VERTEX_SIZE_BITS"}
      ]
    }
  }
}
